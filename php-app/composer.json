{
    "name": "php-monitor/app",
    "description": "Small PHP website with an Illuminate router, a phpinfo page and a Prometheus exporter.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "ext-apcu": "*",
        "illuminate/routing": "^11.0",
        "illuminate/events": "^11.0",
        "promphp/prometheus_client_php": "^2.11"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform": {
            "php": "8.3.0"
        }
    }
}
